<Window x:Class="TokenPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Usage"
        Icon="Assets/agent-usage-icon-256.png"
        Width="372"
        Height="530"
        MinWidth="340"
        MinHeight="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="18">
        <Border CornerRadius="20"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#22FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  ShadowDepth="8"
                                  Opacity="0.42"
                                  Color="#FF000000"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="49"/>
                    <RowDefinition x:Name="CodexRow" Height="192"/>
                    <RowDefinition x:Name="ProviderDividerRow" Height="1"/>
                    <RowDefinition x:Name="ClaudeRow" Height="192"/>
                    <RowDefinition Height="55"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        CornerRadius="19,19,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF27313B" Offset="0"/>
                            <GradientStop Color="#FF2B2826" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid Margin="17,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Image Width="36"
                               Height="36"
                               Source="Assets/agent-usage-icon-256.png"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"/>

                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Agent Usage" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
                                <Ellipse x:Name="LiveDot"
                                         Width="7"
                                         Height="7"
                                         Margin="0,0,6,0"
                                         Fill="{StaticResource SuccessBrush}"/>
                                <TextBlock x:Name="LiveText"
                                           Text="Live"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                            <Button x:Name="SettingsButton"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="Settings_Click"
                                    ToolTip="설정">
                                <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="17"/>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="TopmostMenuItem"
                                                  Header="항상 위"
                                                  IsCheckable="True"
                                                  IsChecked="True"
                                                  Click="Topmost_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="CodexEnabledMenuItem"
                                                  Header="Codex 사용"
                                                  IsCheckable="True"
                                                  IsChecked="True"
                                                  Click="ProviderEnabled_Click"/>
                                        <MenuItem x:Name="ClaudeEnabledMenuItem"
                                                  Header="Claude 사용"
                                                  IsCheckable="True"
                                                  IsChecked="True"
                                                  Click="ProviderEnabled_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Codex 사용량 페이지 열기"
                                                  Click="OpenCodexUsage_Click"/>
                                        <MenuItem Header="Claude 사용량 페이지 열기"
                                                  Click="OpenClaudeUsage_Click"/>
                                        <Separator/>
                                        <MenuItem Header="트레이로 숨기기"
                                                  Click="HideToTray_Click"/>
                                        <MenuItem Header="종료"
                                                  Click="Exit_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="CodexPanel" Grid.Row="1" Margin="18,15,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Image Width="30"
                                   Height="30"
                                   Source="Assets/codex-official.png"
                                   Stretch="Uniform"/>
                            <StackPanel Margin="10,-1,0,0">
                                <TextBlock Text="Codex" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CodexPlanText"
                                           Text="연결 확인 중"
                                           Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="CodexStatusBadge"
                                Grid.Column="1"
                                Height="24"
                                Padding="9,0"
                                CornerRadius="12"
                                Background="#152B8DFF"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CodexStatusText"
                                       Text="확인 중"
                                       FontSize="11"
                                       Foreground="{StaticResource CodexBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="92" Height="92">
                            <Ellipse Margin="7"
                                     Stroke="#FF39393C"
                                     StrokeThickness="10"/>
                            <Path x:Name="CodexArc"
                                  Stroke="{StaticResource CodexBrush}"
                                  StrokeThickness="10"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="CodexRemainingText"
                                           Text="--%"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="남음"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="17,8,0,0">
                            <TextBlock x:Name="CodexWindowLabel"
                                       Text="현재 5시간 세션"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="CodexResetText"
                                       Text="사용량을 불러오는 중입니다"
                                       Margin="0,4,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <ProgressBar x:Name="CodexWeeklyBar"
                                         Margin="0,13,0,0"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Foreground="{StaticResource CodexBrush}"
                                         Style="{StaticResource UsageProgressStyle}"/>
                            <Grid Margin="0,6,0,0">
                                <TextBlock x:Name="CodexSecondaryLabel"
                                           Text="주간 남은 사용량"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="CodexWeeklyText"
                                           Text="--%"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </Grid>
                            <TextBlock x:Name="CodexWeeklyResetText"
                                       Text="주간 초기화 시각 확인 중"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border x:Name="ProviderDivider"
                        Grid.Row="2"
                        Margin="18,0"
                        Background="{StaticResource DividerBrush}"/>

                <Grid x:Name="ClaudePanel" Grid.Row="3" Margin="18,15,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Image Width="30"
                                   Height="30"
                                   Source="Assets/claude-official.png"
                                   Stretch="Uniform"/>
                            <StackPanel Margin="10,-1,0,0">
                                <TextBlock Text="Claude" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ClaudePlanText"
                                           Text="연결 확인 중"
                                           Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="ClaudeStatusBadge"
                                Grid.Column="1"
                                Height="24"
                                Padding="9,0"
                                CornerRadius="12"
                                Background="#15FF9D5C"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ClaudeStatusText"
                                       Text="확인 중"
                                       FontSize="11"
                                       Foreground="{StaticResource ClaudeBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="92" Height="92">
                            <Ellipse Margin="7"
                                     Stroke="#FF39393C"
                                     StrokeThickness="10"/>
                            <Path x:Name="ClaudeArc"
                                  Stroke="{StaticResource ClaudeBrush}"
                                  StrokeThickness="10"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="ClaudeRemainingText"
                                           Text="--%"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="남음"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="17,8,0,0">
                            <TextBlock x:Name="ClaudeWindowLabel"
                                       Text="현재 5시간 세션"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="ClaudeResetText"
                                       Text="사용량을 불러오는 중입니다"
                                       Margin="0,4,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <ProgressBar x:Name="ClaudeWeeklyBar"
                                         Margin="0,13,0,0"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Foreground="{StaticResource ClaudeBrush}"
                                         Style="{StaticResource UsageProgressStyle}"/>
                            <Grid Margin="0,6,0,0">
                                <TextBlock x:Name="ClaudeSecondaryLabel"
                                           Text="주간 남은 사용량"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="ClaudeWeeklyText"
                                           Text="--%"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </Grid>
                            <TextBlock x:Name="ClaudeWeeklyResetText"
                                       Text="주간 초기화 시각 확인 중"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Row="4"
                        CornerRadius="0,0,19,19"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="17,0,12,0">
                        <TextBlock x:Name="UpdatedText"
                                   Text="업데이트 준비 중"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource IconButtonStyle}"
                                Width="34"
                                Height="34"
                                Click="Refresh_Click"
                                ToolTip="지금 새로고침">
                            <TextBlock x:Name="RefreshGlyph"
                                       Text="↻"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="16"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
